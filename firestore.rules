rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 관리자 판정: Custom Claim(admin:true, npm run sync-admins로 배포) 또는
    // 본인 Firestore users 문서의 role/memberGrade — 클라이언트 utils/adminAccess.js의
    // resolveIsAdmin()과 동일한 기준으로 맞춤 (claim이 아직 없는 관리자도 막히지 않도록).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberGrade in ['마스터', '운영진']
          )
        )
      );
    }

    // 본인이 권한·계정 연결 필드를 스스로 바꾸지 못하게 차단 (관리자·서버만 변경 가능).
    // uid/kakaoId/providers는 서버의 카카오 로그인 매칭이 신뢰하는 값이라 본인 수정도 막는다.
    function noPrivilegedFieldChange() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'memberGrade', 'approvalStatus', 'uid', 'kakaoId', 'providers', 'kakaoLinkedAt']);
    }

    // 회원가입 시 스스로 admin/마스터·운영진 권한이나 승인 상태, 남의 uid·카카오 연결을 심어 넣지 못하게 차단
    function noPrivilegedFieldsOnCreate() {
      let d = request.resource.data;
      return !(d.get('role', '') in ['admin', 'master'])
        && !(d.get('memberGrade', '') in ['마스터', '운영진'])
        && d.get('approvalStatus', 'pending') == 'pending'
        && d.get('uid', request.auth.uid) == request.auth.uid
        && (!('kakaoId' in d) || request.auth.uid == 'kakao_' + string(d.kakaoId));
    }

    // 본인 회원 문서 판정: 문서 id가 uid인 경우 + 예전 가입자(문서 id ≠ uid)의 uid/email 필드 일치
    function isOwnUserDoc(userId) {
      return isSelf(userId) || (isSignedIn() && (
        resource.data.get('uid', '') == request.auth.uid ||
        (request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email)
      ));
    }

    // 회원 원본: 연락처·생년월일·사업자번호 등 개인정보 포함 → 본인과 관리자만 읽기.
    // 회원명단 등 공개 화면은 서버가 공개 필드만 복사해 두는 publicProfiles를 읽는다.
    match /users/{userId} {
      allow read: if isAdmin() || isOwnUserDoc(userId);
      allow create: if isSelf(userId) && noPrivilegedFieldsOnCreate();
      allow update: if isAdmin() || (isSelf(userId) && noPrivilegedFieldChange());
      allow delete: if isAdmin() || isSelf(userId);
    }

    // 공개 회원 프로필: Cloud Functions(syncPublicProfile)만 쓰기, 누구나 읽기
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 회원 알림 서브컬렉션: 본인만 읽기/쓰기
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isSelf(userId);
      // 관리자는 회원 정보 정정 알림 등을 남길 수 있음 (읽기·수정은 본인만)
      allow create: if isAdmin();
    }

    // 프로그램/세미나: 읽기 공개, 쓰기는 관리자만
    match /seminars/{seminarId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 외부행사 팝업 포스터(기간·이미지·선택 링크): 읽기 공개, 쓰기는 관리자만
    match /externalEventPosters/{posterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 지원사업 자동 수집 피드: 읽기 공개. 관리자 브라우저 UI에서의 수동 등록/수정/삭제는 isAdmin()만 허용.
    // 주의: 향후 자동 수집 스크립트(scripts/ingest-support-programs.mjs)는 Admin SDK(서비스 계정)로
    // 쓰기 때문에 이 규칙을 완전히 우회함 — 아래 규칙은 브라우저 클라이언트 쓰기에만 적용됨.
    match /supportPrograms/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 뉴스 피드(경제뉴스 자동수집): 읽기 공개. 관리자 브라우저 UI 수동 등록/수정/삭제는 isAdmin()만 허용.
    // 자동 수집 스크립트(scripts/ingest-daily-feed.mjs)는 Admin SDK(서비스 계정)로 쓰기 때문에
    // 이 규칙을 완전히 우회함 — 아래 규칙은 브라우저 클라이언트 쓰기에만 적용됨.
    match /newsItems/{newsId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // 조회수(viewCount)만은 누구나(비로그인 포함) +1씩 올릴 수 있게 허용한다 — 사이트 안에서
      // 기사를 읽을 때마다 클라이언트가 increment(1)을 보낸다(firebaseService.incrementNewsViewCount).
      // 그 외 필드를 함께 바꾸려는 요청이거나, viewCount가 정확히 1씩 늘어난 게 아니면(음수/건너뛰기
      // 등) 거부해서 관리자 외에는 다른 데이터를 손댈 수 없게 막는다.
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount is int
          && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
        );
    }

    // 게시글(커뮤니티·후기): 읽기 공개. 작성은 본인 authorId로만, 수정·삭제는 작성자 본인 또는 관리자
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // 무료 프로그램 여부: 참가비가 없거나 0인 경우만 (유료 신청은 결제 검증 후 서버가 생성)
    function isFreeSeminar(seminarId) {
      let fee = get(/databases/$(database)/documents/seminars/$(seminarId)).data.get('applicationFee', null);
      return fee == null || fee == 0 || fee == '' || fee == '0';
    }

    // 프로그램 신청: 신청자 연락처 포함 → 본인과 관리자만 읽기.
    // 정원 집계 등 공개 화면은 서버가 개인정보 없이 복사해 두는 publicApplications를 읽는다.
    // create: 본인 uid + 무료 프로그램 + 결제 필드 없음 (유료는 /api/payment/complete·webhook만 생성).
    // update: 본인은 신청 내용 필드만 정정 가능 (결제·소유자 필드 변경 금지).
    match /applications/{applicationId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.seminarId is string
        && isFreeSeminar(request.resource.data.seminarId)
        && !request.resource.data.keys().hasAny(['merchant_uid', 'merchantUid', 'imp_uid', 'impUid', 'adminAddedParticipant'])
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participationPath', 'applyReason', 'preQuestions', 'mealAfter',
          'privacyAgreed', 'reason', 'questions', 'updatedAt'
        ])
      );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 공개 신청 집계용 사본(개인정보 없음): Cloud Functions(syncPublicApplication)만 쓰기, 누구나 읽기
    match /publicApplications/{applicationId} {
      allow read: if true;
      allow write: if false;
    }

    // 결제 대기: 구매자 PII 포함 → 클라이언트 접근 금지. 읽기/쓰기/삭제 모두 Cloud Functions(Admin SDK)에서만.
    match /pendingPayments/{docId} {
      allow read, write: if false;
    }

    // 앱 설정(메뉴 등): 읽기 공개, 쓰기는 관리자만
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사이트 콘텐츠: 읽기 공개, 쓰기는 관리자만
    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 검색 로그: 로그인 사용자는 생성만, 조회·수정·삭제는 관리자만
    match /searchLogs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // 맛집: 읽기 공개. 등록은 본인 ownerId로만, 수정은 소유자·마스터/파트너사 등급·관리자,
    // 삭제는 소유자 또는 관리자 (utils/restaurantPermissions.js의 canEditRestaurantInfo와 동일 기준).
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberGrade in ['마스터', '파트너사']
        );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ===== 소모임·스터디(그룹) =====
    // 개설 신청·가입·QR 출석·결제는 서버(functions/groups.js)가 처리하고,
    // 그룹장은 승인된 자기 그룹의 설정·회차·멤버 승인·수동 출석만 직접 바꿀 수 있다.
    function groupData(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }
    function isGroupLeader(gid) {
      return isSignedIn() && groupData(gid).leaderUid == request.auth.uid;
    }
    function validSession() {
      let d = request.resource.data;
      return d.title is string && d.title.size() <= 80
        && d.get('fee', 0) is int && d.get('fee', 0) >= 0 && d.get('fee', 0) <= 1000000;
    }

    match /groups/{gid} {
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (isSignedIn() && resource.data.leaderUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.leaderUid == request.auth.uid && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description', 'region', 'mode', 'schedule', 'capacity', 'joinPolicy', 'notice', 'cover', 'updatedAt'])
        && request.resource.data.joinPolicy in ['open', 'approval']
        && request.resource.data.mode in ['offline', 'online', 'hybrid']
        && request.resource.data.get('cover', 'meetup') in ['study', 'meetup', 'networking', 'workshop', 'online', 'busan']
      );

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create: if isAdmin();
        allow update: if isAdmin()
          || (isGroupLeader(gid) && resource.data.role != 'leader'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['active', 'rejected', 'left'])
          || (isSelf(uid) && resource.data.role != 'leader'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'left');
        allow delete: if isAdmin() || (isGroupLeader(gid) && resource.data.role != 'leader');
      }

      match /sessions/{sid} {
        allow read: if groupData(gid).status == 'approved' || isGroupLeader(gid) || isAdmin();
        allow create, update: if isAdmin() || (isGroupLeader(gid) && validSession());
        allow delete: if isAdmin() || isGroupLeader(gid);

        // 출석: QR 출석·결제 기록(paid/paymentId/amount)은 서버만. 그룹장은 수동 출석·현장 결제(cashPaid)만
        match /attendance/{uid} {
          allow read: if isSelf(uid) || isGroupLeader(gid) || isAdmin();
          allow create: if isAdmin() || (isGroupLeader(gid)
            && request.resource.data.keys().hasOnly(['uid', 'name', 'method', 'checkedAt', 'cashPaid', 'note'])
            && request.resource.data.method == 'manual');
          allow update: if isAdmin() || (isGroupLeader(gid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cashPaid', 'note']));
          allow delete: if isAdmin() || (isGroupLeader(gid) && resource.data.get('paid', false) != true);
        }
      }
    }

    // 신고: 로그인 회원은 본인 이름으로 접수만, 열람·처리는 관리자만
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.targetType in ['group', 'member']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1000
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'targetTitle', 'reason', 'reporterUid', 'reporterName', 'status', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // 그룹 QR 결제 기록(정산 장부): 서버만 쓰기. 결제자 본인·해당 그룹장·관리자만 읽기
    match /groupPayments/{pid} {
      allow read: if isAdmin() || (isSignedIn()
        && (resource.data.uid == request.auth.uid || resource.data.leaderUid == request.auth.uid));
      allow write: if false;
    }

    // 강제 탈퇴 재가입 차단 목록: 클라이언트 접근 불가, Cloud Functions(Admin)에서만 사용
    match /blockedRegistrations/{docId} {
      allow read, write: if false;
    }
  }
}
