rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 관리자 판정: Custom Claim(admin:true, npm run sync-admins로 배포) 또는
    // 본인 Firestore users 문서의 role/memberGrade — 클라이언트 utils/adminAccess.js의
    // resolveIsAdmin()과 동일한 기준으로 맞춤 (claim이 아직 없는 관리자도 막히지 않도록).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberGrade in ['마스터', '운영진']
          )
        )
      );
    }

    // 본인이 role/memberGrade/approvalStatus를 스스로 바꾸지 못하게 차단 (관리자만 변경 가능)
    function noPrivilegedFieldChange() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'memberGrade', 'approvalStatus']);
    }

    // 회원가입 시 스스로 admin/마스터·운영진 권한을 심어 넣지 못하게 차단
    function noPrivilegedFieldsOnCreate() {
      return !(request.resource.data.get('role', '') in ['admin', 'master'])
        && !(request.resource.data.get('memberGrade', '') in ['마스터', '운영진']);
    }

    // 회원: 목록 공개, 본인 문서는 본인이(단, 등급/권한 필드는 관리자만) 쓰기 가능
    match /users/{userId} {
      allow read: if true;
      allow create: if isSelf(userId) && noPrivilegedFieldsOnCreate();
      allow update: if isAdmin() || (isSelf(userId) && noPrivilegedFieldChange());
      allow delete: if isAdmin() || isSelf(userId);
    }

    // 회원 알림 서브컬렉션: 본인만 읽기/쓰기
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isSelf(userId);
    }

    // 프로그램/세미나: 읽기 공개, 쓰기는 관리자만
    match /seminars/{seminarId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 외부행사 팝업 포스터(기간·이미지·선택 링크): 읽기 공개, 쓰기는 관리자만
    match /externalEventPosters/{posterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 지원사업 자동 수집 피드: 읽기 공개. 관리자 브라우저 UI에서의 수동 등록/수정/삭제는 isAdmin()만 허용.
    // 주의: 향후 자동 수집 스크립트(scripts/ingest-support-programs.mjs)는 Admin SDK(서비스 계정)로
    // 쓰기 때문에 이 규칙을 완전히 우회함 — 아래 규칙은 브라우저 클라이언트 쓰기에만 적용됨.
    match /supportPrograms/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 게시글(커뮤니티·후기): 읽기 공개. 작성은 본인 authorId로만, 수정·삭제는 작성자 본인 또는 관리자
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // 프로그램 신청: 읽기는 전체 허용(관리자 명단 표시용).
    // create: 로그인 사용자 본인 uid와 userId 필드가 일치해야 함 (타인 이름 신청 방지).
    // update/delete: 본인 신청 또는 관리자만 (관리자 명단 삭제는 대부분 Cloud Functions Admin SDK 경유 — 규칙 영향 없음).
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 결제 대기: 구매자 PII 포함 → 클라이언트 접근 금지. 읽기/쓰기/삭제 모두 Cloud Functions(Admin SDK)에서만.
    match /pendingPayments/{docId} {
      allow read, write: if false;
    }

    // 앱 설정(메뉴 등): 읽기 공개, 쓰기는 관리자만
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사이트 콘텐츠: 읽기 공개, 쓰기는 관리자만
    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 검색 로그: 로그인 사용자만 생성·조회
    match /searchLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    // 맛집: 읽기 공개. 등록은 본인 ownerId로만, 수정은 소유자·마스터/파트너사 등급·관리자,
    // 삭제는 소유자 또는 관리자 (utils/restaurantPermissions.js의 canEditRestaurantInfo와 동일 기준).
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberGrade in ['마스터', '파트너사']
        );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // 강제 탈퇴 재가입 차단 목록: 클라이언트 접근 불가, Cloud Functions(Admin)에서만 사용
    match /blockedRegistrations/{docId} {
      allow read, write: if false;
    }
  }
}
