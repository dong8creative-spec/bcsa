rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 사이트 업로드 이미지(uploadImageToStorage: images/{type}/{uuid}_{name}).
    // 로그인 사용자는 새 파일 생성만 가능(10MB 이하 이미지). 기존 파일 덮어쓰기·삭제는 관리자 Claim만.
    match /images/{type}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && type in ['program', 'content', 'community', 'company']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
